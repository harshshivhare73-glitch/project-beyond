# Project Beyond — Local Environment Configuration
# Store your local or free-tier API keys here.
# This file is excluded from Git by .gitignore and is NEVER exposed to client code.

# Google Gemini API Key (Official Free Tier: 15 RPM from https://aistudio.google.com)
GEMINI_API_KEY=

# GroqCloud API Key (Free tier: 30 RPM from https://console.groq.com)
GROQ_API_KEY=

# OpenRouter API Key (Free models :free from https://openrouter.ai)
OPENROUTER_API_KEY=

# DeepSeek API Key (Pay-as-you-go from https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenAI API Key (Pay-as-you-go from https://platform.openai.com)
OPENAI_API_KEY=

# Anthropic API Key (Pay-as-you-go from https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama Host (Local default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
